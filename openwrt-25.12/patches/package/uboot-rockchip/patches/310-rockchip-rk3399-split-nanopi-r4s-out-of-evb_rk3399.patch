+++ b/configs/nanopi-r4s-rk3399_defconfig
@@ -9,7 +9,7 @@ CONFIG_DEFAULT_DEVICE_TREE="rockchip/rk3
 CONFIG_DM_RESET=y
 CONFIG_ROCKCHIP_RK3399=y
