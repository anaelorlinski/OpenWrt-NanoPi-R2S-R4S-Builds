+
 config TARGET_PINEBOOK_PRO_RK3399
 	bool "Pinebook Pro"
 	help
@@ -161,6 +166,7 @@ config SYS_BOOTCOUNT_ADDR
 endif # BOOTCOUNT_LIMIT
 
 source "board/firefly/roc-pc-rk3399/Kconfig"
